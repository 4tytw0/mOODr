[Unit]
PartOf=m00dr.target
Description=m800Dr: WebRTC stream of the m800Dr Mix (Opus over UDP; signalling on localhost:8809 via the audio server)
After=pipewire.service pipewire-pulse.service

[Service]
WorkingDirectory=%h/code/m00Dr
ExecStart=/usr/bin/uv run -q surfaces/webrtc.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
