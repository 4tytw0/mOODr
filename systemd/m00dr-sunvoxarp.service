[Unit]
PartOf=m00dr.target
Description=m00Dr: SunVox arp (ch3: stabs, phase sine) via voices/arp into the mixer's arp strip
After=pipewire.service

[Service]
WorkingDirectory=%h/code/m00Dr
ExecStart=/usr/bin/uv run -q voices/arp/player.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
