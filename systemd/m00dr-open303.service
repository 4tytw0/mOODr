[Unit]
Description=m00Dr: Open303 acid (ch5) via Carla + JC303 into the m800Dr Mixer
After=pipewire.service pipewire-pulse.service

[Service]
WorkingDirectory=/home/emin0r/code/m800Dr
# JACK client name, used by synths/links.sh.
Environment=CARLA_CLIENT_NAME=m00Dr-Open303
# Carla expects a fixed JACK buffer size; pin PipeWire's quantum for this node.
Environment=PIPEWIRE_QUANTUM=256/48000
# Headless: no X11 plugin UIs.
Environment=DISPLAY=
ExecStart=/usr/bin/carla-rack --no-gui /home/emin0r/code/m800Dr/synths/open303.carxp
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
