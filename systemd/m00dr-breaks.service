[Unit]
PartOf=m00dr.target
Description=m00Dr: drum breaks (ch8) via breaks.py into the m800Dr Mixer's breaks strip
After=pipewire.service

[Service]
WorkingDirectory=%h/code/m00Dr
ExecStart=/usr/bin/uv run -q voices/breaks/player.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
