[Unit]
Description=m800Dr: per-part mixer on MIDI faders (volume, drive at the top) into the m800Dr Mix
After=pipewire.service

[Service]
# Ask for 256-frame buffers so the graph never sits at PipeWire's default
# 1024: Carla (m00dr-open303) goes silent if it ever sees a different size.
Environment=PIPEWIRE_LATENCY=256/48000
WorkingDirectory=/home/emin0r/code/m800Dr
ExecStart=/usr/bin/uv run -q mixer.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
