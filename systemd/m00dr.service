[Unit]
PartOf=m00dr.target
Description=m00Dr: generative MIDI app (GUI + iPad web remote) driving the m800Dr synths
# A Qt GUI, so it lives with the Plasma session rather than starting at boot.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
WorkingDirectory=%h/code/m00Dr
ExecStart=/usr/bin/uv run python composer/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
