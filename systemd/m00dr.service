[Unit]
Description=m00Dr: generative MIDI app (GUI + iPad web remote) driving the m800Dr synths
# A Qt GUI, so it lives with the Plasma session rather than starting at boot.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
WorkingDirectory=/home/emin0r/code/mOODr
ExecStart=/usr/bin/uv run python main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
